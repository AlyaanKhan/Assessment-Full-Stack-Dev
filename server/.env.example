# Copy this file to .env and fill in the values. Never commit the real .env.

# Where the API listens.
PORT=4000

# PostgreSQL connection string.
DATABASE_URL=

# Long random string used to sign login tokens.
JWT_SECRET=

# Groq API credentials for the AI service.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant

# Where the browser app runs, so the API can accept its requests.
CLIENT_ORIGIN=http://localhost:5173
